# Base path axios/fetch dùng - giống hệt build-web/task-web. Luôn tương đối
# (/api), không phải URL tuyệt đối: `pnpm dev` có vite dev server proxy /api
# sang gateway local (xem vite.config.ts), production nginx của sso-web tự
# proxy (xem config/default.conf) - cả 2 môi trường đều same-origin, không
# cần CORS (gateway không còn biến SSO_ORIGIN nữa).
VITE_BASE_URL=/api

# Hậu tố domain được phép cho tham số ?redirect= (chống open-redirect). Chỉ
# redirect sang URL https có hostname kết thúc bằng chuỗi này, hoặc path nội bộ.
# Vd: .xaydung.vn
VITE_ALLOWED_REDIRECT_SUFFIX=

# Domain cha dùng chung với build-web - toggle sáng/tối ghi cookie theme_mode ở
# domain này để 2 app đồng bộ theme. Rỗng = cookie host-only (toggle vẫn chạy).
# Vd: .xaydung.vn
VITE_COOKIE_DOMAIN=
