# URL tuyệt đối của api-gateway - sso-web là frontend độc lập (origin riêng),
# gọi API cross-origin sang gateway. Gateway phải có CORS cho origin của sso-web
# (biến SSO_ORIGIN bên api-gateway). Rỗng = gọi tương đối (chỉ đúng khi cùng
# origin với gateway, không phải setup hiện tại).
VITE_GATEWAY_URL=http://localhost:6688

# Hậu tố domain được phép cho tham số ?redirect= (chống open-redirect). Chỉ
# redirect sang URL https có hostname kết thúc bằng chuỗi này, hoặc path nội bộ.
# Vd: .xaydung.vn
VITE_ALLOWED_REDIRECT_SUFFIX=
