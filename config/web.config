<?xml version="1.0" encoding="utf-8"?>
<!--
  BẢN RIÊNG CHO sso-web (26/09/2026): khác web.config gốc ở rule SPA - request
  trang (không phải file) proxy sang api-sso /render-page để nhận index.html kèm
  thẻ meta/Open Graph lấy từ DB (tab Thương hiệu). Cần api-sso có
  SSO_WEB_TEMPLATE_URL trỏ file index.template.html của site này (vd
  http://localhost:<port sso-web>/index.template.html).
  IIS không tự rơi về index.html tĩnh khi api-sso lỗi (nginx thì có) - api-sso
  không chạy thì cũng không đăng nhập được nên chấp nhận; muốn tắt render, dùng
  lại web.config gốc (rule "Rewrite Text Requests" -> /index.html).

  == Ghi chú của web.config gốc ==
  web.config IIS cho site frontend (build-web / task-web / sso-web) deploy
  không Docker. GIỐNG HỆT bản đang chạy, CHỈ đảo thứ tự 2 rule: đưa
  ReverseProxyInboundRule lên TRƯỚC "Rewrite Text Requests".

  Vì sao: rule SPA có điều kiện Accept ^text/html + stopProcessing. Mở
  /api/api-core/uploads/<file>.png bằng thanh địa chỉ trình duyệt gửi
  Accept: text/html -> rule SPA nuốt -> rewrite /index.html -> "về home".
  Để proxy lên trước thì mọi /api/* luôn đi thẳng gateway.

  Yêu cầu: URL Rewrite + ARR đã cài, ARR "Enable proxy" đã bật (nếu 500 sau
  khi đổi -> gần như chắc chắn ARR proxy chưa bật, xem hướng dẫn trong chat).
-->
<configuration>
  <system.webServer>
    <!-- IIS mặc định KHÔNG có MIME cho .webmanifest -> trả 404 cho
         /site.webmanifest (index.html có <link rel="manifest">). Khai ở đây.
         `remove` trước `mimeMap` để idempotent nếu server đã khai sẵn.

         .woff2/.woff cũng khai phòng hờ cùng lý do (nghi vấn tiếng Việt
         "lỗi font" 18/09/2026 - đã verify font-file self-host MD5 khớp
         tuyệt đối với Google Fonts CDN thật, không phải sai font; nếu IIS
         thiếu MIME cho .woff2 thì trình duyệt có thể từ chối dùng font tải
         về, tự rơi về font hệ thống - falls back âm thầm, không phải lỗi
         hiện rõ như 404, khó nhận ra hơn .webmanifest). Hầu hết IIS bản mới
         đã có sẵn 2 MIME này, khai lại ở đây không hại gì nếu đã có. -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
    </staticContent>

    <rewrite>
      <rules>
        <rule name="ReverseProxyInboundRule" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://103.15.51.222:6888/api/{R:1}" />
        </rule>
        <rule name="Rewrite Text Requests" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_METHOD}" pattern="^GET$" />
            <add input="{HTTP_ACCEPT}" pattern="^text/html" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <!-- UrlEncode: đường dẫn gốc (kèm query) đi qua ?path= -->
          <action type="Rewrite" url="http://103.15.51.222:6888/api/api-sso/render-page?path={UrlEncode:{REQUEST_URI}}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
